# Lightweight multi-arch (amd64/arm64) CPU runtime for Parakeet TDT 0.6B v3 ONNX.
# No PyTorch or CUDA dependencies; model revision is pinned in app.py.
FROM python:3.14-slim-trixie
RUN apt-get update && apt-get upgrade -y --no-install-recommends && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.13.9 /uv /usr/local/bin/uv
WORKDIR /app
RUN uv venv /app/.venv \
    && uv pip install --python /app/.venv/bin/python --no-cache \
      fastapi==0.165.0 \
      'uvicorn[standard]==0.54.0' \
      'numpy>=2.0,<3' \
      'huggingface-hub>=0.30.2,<2' \
      onnx-asr==0.12.0 \
      onnxruntime==1.32.0 \
    && /app/.venv/bin/python -c 'import fastapi, huggingface_hub, numpy, onnx_asr, onnxruntime' \
    && rm -rf /usr/local/bin/uv /usr/local/bin/pip* /usr/local/lib/python3.14/ensurepip /usr/local/lib/python3.14/site-packages/pip* \
    && useradd --uid 10001 --create-home wortlaut \
    && mkdir /model-cache \
    && chown 10001:10001 /model-cache
COPY services/asr/app.py /app/app.py
RUN /app/.venv/bin/python -m py_compile /app/app.py
ENV PATH="/app/.venv/bin:$PATH" \
    HF_HOME=/model-cache \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    WORTLAUT_ASR_BACKEND=parakeet \
    WORTLAUT_ASR_DEVICE=cpu \
    WORTLAUT_ASR_QUANTIZATION=int8
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD ["/app/.venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=3)"]
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--limit-concurrency", "4", "--timeout-graceful-shutdown", "180"]
