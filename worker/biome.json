{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "runtime/**/*.ts",
      "test/**/*.ts",
      "scripts/**/*.mjs",
      "!src/vendor",
      "!dist",
      "!dist-worker",
      "!public"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noAssignInExpressions": "off",
        "noArrayIndexKey": "off"
      },
      "performance": {
        "useDomNodeTextContent": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useButtonType": "error",
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "off",
        "useTemplate": "off",
        "useConst": "off",
        "useNodejsImportProtocol": "error"
      },
      "complexity": {
        "noForEach": "off",
        "noExtraBooleanCast": "off",
        "noUselessEscapeInRegex": "off",
        "useOptionalChain": "off",
        "useMathMinMax": "off"
      }
    }
  }
}
