{
  "name": "wortlaut-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/assets.mjs && vite build && vite build --config vite.meet.config.ts && vite build --config vite.ui.config.ts && tsc -p tsconfig.worker.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "start": "node dist-worker/runtime/main.js",
    "test:audio": "node --import tsx test/browser-audio.ts",
    "test:meet": "node --import tsx test/browser-meet.ts",
    "test:live": "node --import tsx test/live-provider-e2e.ts",
    "test:receiver": "uv run --directory ../services/meeting python ../../worker/test/receiver.py"
  },
  "dependencies": {
    "@alexanderolsen/libsamplerate-js": "2.1.2",
    "@astryxdesign/core": "^0.7.11",
    "@astryxdesign/theme-stone": "^0.7.11",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "playwright": "1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "webex": "3.13.0"
  },
  "overrides": {
    "form-data": "^2.5.6",
    "node-forge": "^1.4.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.11",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
