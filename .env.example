# ==============================================================================
# wortlaut — Environment Configuration (.env)
# ==============================================================================
# Copy this file to `.env` before starting with Docker Compose:
#   cp .env.example .env
#   chmod 600 .env
#   docker compose up -d
#
# With NVIDIA GPU (recommended for real-time Parakeet ASR):
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
# ==============================================================================

# --- Core Secrets (change before exposing to a network!) ----------------------
WORTLAUT_API_TOKEN=change-me-admin-bearer-token
WORTLAUT_POSTGRES_PASSWORD=change-me-postgres-password
WORTLAUT_S3_ACCESS_KEY=wortlaut-s3
WORTLAUT_S3_SECRET_KEY=change-me-s3-secret-key
WORTLAUT_ASR_TOKEN=change-me-internal-asr-token

# --- Network & Public URLs ----------------------------------------------------
WORTLAUT_PORT=34601
WORTLAUT_IMAGE_TAG=latest
# When behind a public HTTPS reverse proxy (e.g. https://wortlaut.example.org/),
# set WORTLAUT_API_URL so calendar protocol links and OAuth2 callbacks match:
# WORTLAUT_API_URL=https://wortlaut.example.org/
# WORTLAUT_SDK_PAGE_URL=https://wortlaut.example.org/sdk/

# --- Speech Recognition (Local Parakeet ASR) & Default Language ---------------
# Default UI / bot chat language: "en" or "de"
WORTLAUT_DEFAULT_LOCALE=en
# Default 25-language European multilingual model ("nvidia/parakeet-tdt-0.6b-v3")
# or optional German-only fine-tune ("primeline/parakeet-primeline"):
WORTLAUT_ASR_MODEL_REPO=nvidia/parakeet-tdt-0.6b-v3

# --- Conference Providers -----------------------------------------------------
WORTLAUT_ENABLE_GOOGLE_MEET=true
WORTLAUT_ENABLE_TEAMS=true
WORTLAUT_ENABLE_ZOOM=true
WORTLAUT_ZOOM_LOCALE=en-US

# --- Optional: OIDC Multi-User Login (Dex, Keycloak, Authentik, Entra ID) -----
# Leave empty to use single-user Bearer token login via WORTLAUT_API_TOKEN.
WORTLAUT_OIDC_ISSUER=
WORTLAUT_OIDC_CLIENT_ID=wortlaut
WORTLAUT_OIDC_ALLOWED_DOMAINS=[]
WORTLAUT_OIDC_ADMIN_EMAILS=[]

# --- Optional: Calendar OAuth2 Sync & Automatic Protocol Linking --------------
WORTLAUT_GOOGLE_CALENDAR_CLIENT_ID=
WORTLAUT_GOOGLE_CALENDAR_CLIENT_SECRET=
WORTLAUT_MICROSOFT_CALENDAR_CLIENT_ID=
WORTLAUT_MICROSOFT_CALENDAR_CLIENT_SECRET=
WORTLAUT_MICROSOFT_CALENDAR_TENANT_ID=common

# --- Optional: Local Executive Summary (Ollama) -------------------------------
WORTLAUT_ENABLE_LLM_SUMMARY=false
WORTLAUT_OLLAMA_URL=http://host.docker.internal:11434
WORTLAUT_OLLAMA_MODEL=qwen3.8:latest
