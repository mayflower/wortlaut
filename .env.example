# ==============================================================================
# wortlaut — Environment Configuration (.env)
# ==============================================================================
# Copy this file to `.env` before starting with Docker Compose:
#   cp .env.example .env
#   chmod 600 .env
#   docker compose up -d
#
# With NVIDIA GPU (recommended for real-time Qwen3-ASR):
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
# ==============================================================================

# --- Core Secrets (change before exposing to a network!) ----------------------
WORTLAUT_API_TOKEN=change-me-admin-bearer-token
# Dedicated encryption key for stored OAuth/calendar tokens (recommended in production
# so rotating WORTLAUT_API_TOKEN never invalidates connected calendars; e.g. `openssl rand -base64 32`):
WORTLAUT_ENCRYPTION_KEY=
WORTLAUT_POSTGRES_PASSWORD=change-me-postgres-password
WORTLAUT_S3_ACCESS_KEY=wortlaut-s3
WORTLAUT_S3_SECRET_KEY=change-me-s3-secret-key
WORTLAUT_ASR_TOKEN=change-me-internal-asr-token

# --- Network & Public URLs ----------------------------------------------------
WORTLAUT_PORT=34601
WORTLAUT_IMAGE_TAG=latest
# When behind a public HTTPS reverse proxy (e.g. https://wortlaut.example.org/),
# set WORTLAUT_PUBLIC_URL so browser OAuth callbacks, calendar links, and /privacy
# use the public HTTPS origin while workers keep streaming to internal http://meeting:8000/:
# WORTLAUT_PUBLIC_URL=https://wortlaut.example.org/
# WORTLAUT_API_URL=http://meeting:8000/
# WORTLAUT_SDK_PAGE_URL=http://meeting:8000/sdk/

# --- Speech Recognition (Parakeet ONNX / Qwen3-ASR) & Default Language --------
# Default UI / bot chat / live video-tile language: "en" or "de"
WORTLAUT_DEFAULT_LOCALE=en
# ASR backend: "parakeet" (Parakeet TDT 0.6B v3 ONNX, fast on CPU & GPU, 25 EU languages)
# or "qwen3" (Qwen3-ASR 1.7B, 30 languages + glossary context prompts, NVIDIA GPU recommended).
# Leave these commented to use each Compose file's built-in defaults:
#   docker-compose.yml     -> parakeet on cpu (slim wortlaut-asr-cpu image)
#   docker-compose.gpu.yml -> qwen3 on cuda   (GPU wortlaut-asr image)
# Uncomment only to override explicitly (e.g. WORTLAUT_ASR_BACKEND=parakeet with docker-compose.gpu.yml):
# WORTLAUT_ASR_BACKEND=parakeet
# WORTLAUT_ASR_DEVICE=auto
# WORTLAUT_ASR_QUANTIZATION=auto
# Optional Hugging Face repo/revision override (leave empty for backend's pinned default):
WORTLAUT_ASR_MODEL_REPO=
WORTLAUT_ASR_MODEL_REVISION=
# Default languages ("*" = auto; or e.g. "German,English"):
WORTLAUT_ASR_LANGUAGES=*
# Optional custom domain vocabulary / product names (used by Qwen3-ASR & RAG search):
WORTLAUT_ASR_GLOSSARY=

# --- Conference Providers & Screen-Share Slide Keyframes ----------------------
WORTLAUT_ENABLE_GOOGLE_MEET=true
WORTLAUT_ENABLE_TEAMS=true
WORTLAUT_ENABLE_ZOOM=true
WORTLAUT_ZOOM_LOCALE=en-US
WORTLAUT_ENABLE_WEBEX_BROWSER=true
# Static PNG snapshots strictly from verified screen shares (never camera video):
WORTLAUT_ENABLE_KEYFRAMES=true

# --- Optional: Multi-User Sign-In (OIDC, Microsoft Entra ID, Google) ----------
# Leave all providers empty for single-user Bearer token login via WORTLAUT_API_TOKEN.
# Shared access rules apply across all enabled sign-in providers:
WORTLAUT_OIDC_ALLOWED_DOMAINS=[]
WORTLAUT_OIDC_ADMIN_EMAILS=[]

# Option A: Generic OIDC (Dex, Keycloak, Authentik, etc.)
WORTLAUT_OIDC_ISSUER=
WORTLAUT_OIDC_CLIENT_ID=wortlaut
WORTLAUT_OIDC_CLIENT_SECRET=
WORTLAUT_OIDC_DISPLAY_NAME=

# Option B: Microsoft Entra ID (Azure AD)
# Set WORTLAUT_ENTRA_AUTH_TENANT_ID to your tenant UUID (recommended single-tenant),
# or to "organizations"/"common" together with WORTLAUT_ENTRA_AUTH_ALLOWED_TENANTS.
WORTLAUT_ENTRA_AUTH_CLIENT_ID=
WORTLAUT_ENTRA_AUTH_CLIENT_SECRET=
WORTLAUT_ENTRA_AUTH_TENANT_ID=
WORTLAUT_ENTRA_AUTH_ALLOWED_TENANTS=[]

# Option C: Google Sign-In (OIDC)
WORTLAUT_GOOGLE_AUTH_CLIENT_ID=
WORTLAUT_GOOGLE_AUTH_CLIENT_SECRET=

# --- Optional: Calendar OAuth2 Sync & Automatic Protocol Linking --------------
WORTLAUT_GOOGLE_CALENDAR_CLIENT_ID=
WORTLAUT_GOOGLE_CALENDAR_CLIENT_SECRET=
WORTLAUT_MICROSOFT_CALENDAR_CLIENT_ID=
WORTLAUT_MICROSOFT_CALENDAR_CLIENT_SECRET=
WORTLAUT_MICROSOFT_CALENDAR_TENANT_ID=common

# --- Optional: Local Executive Summary (Ollama) or Single OpenAI-Compatible Endpoint ---
# WORTLAUT_ENABLE_LLM_SUMMARY=true is always required for post-call summaries/slide text.
WORTLAUT_ENABLE_LLM_SUMMARY=false
WORTLAUT_OLLAMA_URL=http://host.docker.internal:11434
WORTLAUT_OLLAMA_MODEL=qwen3.8:latest
# Optional single external OpenAI-compatible /v1/chat/completions endpoint
# (used for MCP search_protocols query-only synonym expansion; also powers post-call
# summaries when WORTLAUT_ENABLE_LLM_SUMMARY=true; no /v1/embeddings API required):
WORTLAUT_OPENAI_BASE_URL=
WORTLAUT_OPENAI_API_KEY=
WORTLAUT_OPENAI_MODEL=gpt-4o-mini
WORTLAUT_OPENAI_TIMEOUT_SECONDS=120
