# ==============================================================================
# wortlaut — Vorlage für automatisierte E2E-Live-Tests (.env.live)
# ==============================================================================
# Kopiere diese Datei nach `.env.live` (wird von Git ignoriert) und trage deine
# echten Test-Meeting-URLs ein:
#   cp .env.live.example .env.live
#   chmod 600 .env.live
#
# Ausführung:
#   make test-live                        # Alle konfigurierten Provider testen
#   make test-live PROVIDER=teams         # Nur Microsoft Teams testen
#   make test-live PROVIDER=google_meet   # Nur Google Meet testen
#   make test-live PROVIDER=webex         # Nur Webex testen
#   make test-live PROVIDER=zoom          # Nur Zoom testen
#
# Optional Host-Login-Session aufzeichnen (für automatisches Lobby-Admit):
#   make test-live-login PROVIDER=google_meet
# ==============================================================================

WORTLAUT_LIVE_API_URL=https://wortlaut.example.org
WORTLAUT_LIVE_API_TOKEN=
WORTLAUT_LIVE_PROVIDERS=google_meet,webex,teams,zoom

# Google Meet
WORTLAUT_LIVE_MEET_URL=
WORTLAUT_LIVE_MEET_HOST_STORAGE_STATE=.dev/google_meet-host-state.json
WORTLAUT_LIVE_MEET_GUEST_STORAGE_STATE=

# Cisco Webex
WORTLAUT_LIVE_WEBEX_URL=
WORTLAUT_LIVE_WEBEX_HOST_STORAGE_STATE=.dev/webex-host-state.json

# Microsoft Teams
WORTLAUT_LIVE_TEAMS_URL=
WORTLAUT_LIVE_TEAMS_HOST_STORAGE_STATE=.dev/teams-host-state.json

# Zoom
WORTLAUT_LIVE_ZOOM_URL=

# Test-Parameter
WORTLAUT_LIVE_SPEAKER_A_NAME=Alice Test
WORTLAUT_LIVE_SPEAKER_B_NAME=Bob Test
WORTLAUT_LIVE_JOIN_TIMEOUT_SECONDS=120
WORTLAUT_LIVE_PROCESSING_TIMEOUT_SECONDS=90
WORTLAUT_LIVE_REQUIRE_SPEAKER_BINDING=true
WORTLAUT_LIVE_HEADED=false
